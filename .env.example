# Application
APP_NAME=Age Gender Speech API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Model
MODEL_NAME=audeering/wav2vec2-large-robust-24-ft-age-gender
MODEL_DEVICE=cpu
# Set true in offline/prod after model is cached
MODEL_LOCAL_FILES_ONLY=false
# Point at existing HF cache on this machine if desired:
# HF_HOME=/data/huggingface
TARGET_SAMPLING_RATE=16000
AGE_SCALE=100.0

# Limits
MAX_AUDIO_SECONDS=60
MAX_UPLOAD_BYTES=26214400

# API
API_PREFIX=/api/v1
CORS_ORIGINS=*
